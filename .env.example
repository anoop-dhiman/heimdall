# ==============================================================================
# Heimdall: DevOps Guardian - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Settings (Required)
# ------------------------------------------------------------------------------
# Create a bot with @BotFather on Telegram and paste the HTTP API bot token here:
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Whitelist of Telegram User IDs allowed to interact with the bot.
# Comma-separated list (e.g. 123456789,987654321).
# Find your Telegram ID by messaging @userinfobot or @raw_data_bot on Telegram.
# WARNING: If left empty, ANY user who messages the bot can execute commands!
ALLOWED_TELEGRAM_USER_IDS=123456789

# ------------------------------------------------------------------------------
# 2. LLM Provider Settings (Bifrost Gemini Gateway or Direct Anthropic)
# ------------------------------------------------------------------------------
# Google Gemini API Key used by Bifrost sidecar:
GOOGLE_API_KEY=AIzaSy...

# Optional encryption key for Bifrost (random 32-character string if desired)
BIFROST_ENCRYPTION_KEY=

# Base URL pointing to the local Bifrost gateway sidecar (internal Docker network)
ANTHROPIC_BASE_URL=http://bifrost:8080/anthropic

# Optional host loopback port for Bifrost (bound strictly to 127.0.0.1, defaults to 28475)
BIFROST_PORT=28475

# Bifrost container user UID/GID (defaults to 1000:0 to match host volume ownership)
BIFROST_UID=1000
BIFROST_GID=0

# API Key passed to Claude Code (arbitrary token when routed through Bifrost)
ANTHROPIC_API_KEY=dummy-key

# Model mapping to Gemini models via Bifrost:
ANTHROPIC_DEFAULT_FABLE_MODEL="gemini-3.1-pro-preview[1m]"
ANTHROPIC_DEFAULT_OPUS_MODEL="gemini-3.1-pro-preview[1m]"
ANTHROPIC_DEFAULT_SONNET_MODEL="gemini-3.8-flash[1m]"
ANTHROPIC_DEFAULT_HAIKU_MODEL="gemini-3.5-flash-lite[1m]"

# ------------------------------------------------------------------------------
# 3. Host Git Repository & Container-Only PAT Authentication
# ------------------------------------------------------------------------------
# Absolute path on the host machine to your checked-out Git repository.
# This directory will be mounted directly into /workspace inside the container.
# Example: /home/user/my-project or ../my-project
HOST_REPO_PATH=./workspace

# Personal Access Token (PAT) with repo read/write permissions.
# SECURITY GUARANTEE:
# - GIT_PAT is stored STRICTLY inside the container's isolated /root/.git-credentials
#   and /root/.gitconfig.
# - It is NEVER written to the host's filesystem or the mounted repository's .git/config.
# - On the host, git remote -v and git config remain clean without any tokens.
GIT_PAT=ghp_yourPersonalAccessTokenHere

# Git author identity for commits made by Claude Code inside the container
GIT_USER_NAME="Heimdall Dev Agent"
GIT_USER_EMAIL="heimdall@internal"

# ------------------------------------------------------------------------------
# 4. Kubernetes Cluster Access (Kubeconfig)
# ------------------------------------------------------------------------------
# Path to host kubeconfig directory (defaults to ~/.kube mounted as read-only)
HOST_KUBE_PATH=~/.kube

# Or provide base64-encoded kubeconfig directly (cat ~/.kube/config | base64):
KUBECONFIG_BASE64=

# ------------------------------------------------------------------------------
# 5. Docker Registry Authentication (Optional - to push built images)
# ------------------------------------------------------------------------------
# Docker registry host (leave empty for default Docker Hub, or e.g. myacr.azurecr.io, ghcr.io)
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Advanced Agent Settings (Optional)
# ------------------------------------------------------------------------------
# Directory inside container where code is cloned and commands execute (default: /workspace)
WORKSPACE_DIR=/workspace
